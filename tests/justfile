#!/usr/bin/env just --justfile

[default]
[doc('List available commands.')]
help:
    @just --justfile {{ justfile() }} --list --unsorted

[doc('Mirror source packages in tests, preserving existing files.')]
setup_directories:
    #!/usr/bin/env bash
    set -euo pipefail
    cd "$(git rev-parse --show-toplevel)"
    while IFS= read -r -d '' source_init; do
        package_path="${source_init#src/}"
        test_init="tests/$package_path"
        package="${package_path%/__init__.py}"
        package="${package//\//.}"
        mkdir -p "$(dirname "$test_init")"
        if [[ ! -e "$test_init" ]]; then
            printf 'Creating %s\n' "$test_init"
            printf '"""Tests for %s."""\n' "$package" > "$test_init"
        fi
    done < <(find src -type f -name __init__.py -print0)

[doc('Profile tsdm import time with tuna.')]
time-imports:
    #!/usr/bin/env bash
    dependencies=(
      torch
      torch.utils.tensorboard
      pandas
      pyarrow
      pyarrow.compute
      pyarrow.parquet
      polars
      numpy
      scipy.stats
      sklearn.model_selection
      matplotlib.pyplot
    )
    # get project root with git
    cd "$(git rev-parse --show-toplevel)" || exit
    echo "Project root: $(pwd)"
    IFS=,
    uv run python -X importtime -c \
      "import ${dependencies[*]}; import tsdm" \
      2> tests/import_time.log
    uv run tuna tests/import_time.log
