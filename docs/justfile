#!/usr/bin/env -S just --justfile
BUILD_DIR := "./build"

[default]
[doc('List available commands.')]
help:
    @just --justfile {{ justfile() }} --list --unsorted

alias make := build

[doc("Build the Zensical site with generated API Markdown and strict validation.")]
build *zensical_args:
    # Stage authored pages and theme assets, and generate API Markdown and navigation.
    uv run python prepare_sources.py
    uv run zensical build --strict --config-file zensical.toml {{ zensical_args }}

[doc('Clean all documentation build artifacts.')]
clean:
    rm -rf {{ BUILD_DIR }}
